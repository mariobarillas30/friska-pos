{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuario con información de rol para control de acceso RBAC",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Identificador único de Firebase Auth"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico registrado"
        },
        "displayName": {
          "type": "string",
          "description": "Nombre de usuario",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "URL opcional de foto de perfil"
        },
        "role": {
          "type": "string",
          "enum": ["CEO", "Supervisor", "Cajero", "Cocinero"],
          "description": "Rol asignado para el control de acceso en Friska POS"
        },
        "createdAt": {
          "type": "number",
          "description": "Marca de tiempo de registro"
        },
        "lastLogin": {
          "type": "number",
          "description": "Marca de tiempo del último inicio de sesión"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "Estado de la cuenta"
        }
      },
      "required": ["uid", "email", "displayName", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Colección de perfiles de usuario y roles RBAC"
    }
  }
}
